nd_use_ssl=ssl_conf,\n+    task_serializer='json',\n+    accept_content=['json'],\n+    result_serializer='json',\n+    timezone='America/Los_Angeles',\n+    enable_utc=T"},{"startIndex":16670,"endIndex":16990,"filepath":"/home/admin_/ArchitecureII.md","citationText":"task_time_limit=3600,\n+    task_soft_time_limit=3300,\n+    redis_socket_timeout=30,\n+    redis_socket_connect_timeout=30,\n+    redis_retry_on_timeout=True\n+)\n+\n+@celery_app.task(bind=True, max_retries=3)\n+def process_vector_embedding(self, document_id: str, tenant_id: str, matter_id: str):\n+    \"\"\"\n+    Background work"},{"startIndex":17158,"endIndex":17572,"filepath":"/home/admin_/ArchitecureII.md","citationText":"main.py\n+# ==============================================================================\n+# SHTIYA OS: NODE 01 - FASTAPI ENTRYPOINT\n+# ==============================================================================\n+\n+from fastapi import FastAPI, Depends, APIRouter, Request\n+from fastapi.middleware.cors import CORSMiddleware\n+from sqlalchemy.ext.asyncio import AsyncSession\n+from sqlalchemy import text\n+import l"},{"startIndex":17582,"endIndex":17866,"filepath":"/home/admin_/ArchitecureII.md","citationText":"from database import get_secure_db_session, engine\n+from dependencies import verify_external_api_throughput\n+from cache import redis_client\n+\n+logger = logging.getLogger(\"ShtiyaOS_Main\")\n+\n+app = FastAPI(\n+    title=\"Shtiya OS Legal \u0026 Medical Core\",\n+    version=\"1.8.4\",\n+    descrip"},{"startIndex":17945,"endIndex":18421,"filepath":"/home/admin_/ArchitecureII.md","citationText":"Node 04 IDE\n+app.add_middleware(\n+    CORSMiddleware,\n+    allow_origins=[\"https://ide.shtiya.internal\"], \n+    allow_credentials=True,\n+    allow_methods=[\"*\"],\n+    allow_headers=[\"*\"],\n+)\n+\n+router = APIRouter(prefix=\"/api/v1\")\n+\n+@router.get(\"/health\", summary=\"Infrastructure Boundary Health Check\")\n+async def health_check():\n+    \"\"\"Validates connectivity across the Zero-Trust network.\"\"\"\n+    db_status = \"unavailable\"\n+    cache_status = \"unavailable\"\n+    \n+    try"},{"startIndex":18432,"endIndex":18975,"filepath":"/home/admin_/ArchitecureII.md","citationText":"async with engine.connect() as conn:\n+            await conn.execute(text(\"SELECT 1\"))\n+        db_status = \"ok\"\n+    except Exception as e:\n+        logger.error(f\"DB Healthcheck failed: {str(e)}\")\n+        \n+    try:\n+        await redis_client.ping()\n+        cache_status = \"ok\"\n+    except Exception as e:\n+        logger.error(f\"Cache Healthcheck failed: {str(e)}\")\n+\n+    return {\n+        \"boundary_status\": \"SECURE\",\n+        \"cloud_sql\": db_status,\n+        \"memorystore\": cache_status\n+    }\n+\n+@router.post(\"/clio/sync\", dependenci"},{"startIndex":19022,"endIndex":19126,"filepath":"/home/admin_/ArchitecureII.md","citationText":"async def trigger_clio_synchronization(request: Request):\n+    \"\"\"\n+    Triggers outbound synchronizatio"},{"startIndex":19183,"endIndex":19429,"filepath":"/home/admin_/ArchitecureII.md","citationText":"user_id = request.headers.get(\"X-Clio-User-ID\")\n+    logger.info(f\"Initiating synchronization pipeline for user {user_id}\")\n+    # Dispatch to Celery worker...\n+    return {\"status\": \"Synchronization enqueued safely\"}\n+\n+app.include_router(router"}],"ideContext":{"currentFile":{"path":"/home/admin_/AechitectureI.md","language":"markdown","selection":{"start":93900,"end":93900},"includedReason":"CURRENTLY_OPEN"},"remoteContexts":null,"remoteRepositories":[],"otherFiles":[{"path":"/home/admin_/ArchitecureII.md","language":"markdown","selection":{"start":0,"end":0},"includedReason":"RECENTLY_EDITED"},{"path":"/home/admin_/ARCHITECTURE.md","language":"markdown","selection":{"start":0,"end":0},"includedReason":"CHAT_SUGGESTED_EDIT"},{"path":"/home/admin_/README-cloudshell.txt","language":"plaintext","selection":{"start":0,"end":0},"includedReason":"CHA